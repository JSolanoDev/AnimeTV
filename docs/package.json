{
  "name": "animetv",
  "version": "2.0.0",
  "description": "Responsive anime catalog and player for web, Android mobile, and Android TV.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && node --check app.js",
    "android:build": "cd ..\\android && .\\gradlew.bat assembleMobileDebug assembleTvDebug",
    "android:install:mobile": "adb install -r ..\\android/app/build/outputs/apk/mobile/debug/app-mobile-debug.apk",
    "android:install:tv": "adb install -r ..\\android/app/build/outputs/apk/tv/debug/app-tv-debug.apk"
  },
  "keywords": [
    "anime",
    "android-tv",
    "streaming",
    "japanese-audio",
    "spanish-subtitles"
  ],
  "author": "JSolanoDev",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  }
}
